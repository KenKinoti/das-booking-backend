// IntegrationHandler handles integration-related endpoints
type IntegrationHandler struct {
	db               *gorm.DB
	encrypt          *encryption.EncryptionService
	stripeService    *integrations.StripeService
	emailService     *integrations.EmailService
	twilioService    *integrations.TwilioService
	whatsappService  *integrations.WhatsAppService
}

// NewIntegrationHandler creates a new integration handler
func NewIntegrationHandler(db *gorm.DB) *IntegrationHandler {
	return &IntegrationHandler{
		db:               db,
		encrypt:          encryption.GlobalEncryption,
		stripeService:    integrations.NewStripeService(db),
		emailService:     integrations.NewEmailService(db),
		twilioService:    integrations.NewTwilioService(db),
		whatsappService:  integrations.NewWhatsAppService(db),
	}
}

// GetIntegrationSettings gets integration settings for an organization
func (h *IntegrationHandler) GetIntegrationSettings(c *gin.Context) {
	organizationID := c.Param("organizationId")
	if organizationID == "" {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Organization ID is required"})
		return
	}

	var settings models.IntegrationSettings
	if err := h.db.Where("organization_id = ?", organizationID).First(&settings).Error; err != nil {
		if err == gorm.ErrRecordNotFound {
			// Create default settings
			settings = models.IntegrationSettings{
				OrganizationID: organizationID,
				GeneralSettings: models.GeneralSettings{
					PlatformName:    "DAS Booking Platform",
					DefaultTimezone: "UTC",
					DefaultCurrency: "USD",
				},
				EmailSettings: models.EmailSettings{
					Provider: "smtp",
				},
				SecuritySettings: models.SecuritySettings{
					SessionTimeout:      30,
					PasswordMinLength:   8,
					RequireSpecialChars: true,
					RequireNumbers:      true,
					RateLimitRequests:   100,
					RateLimitWindow:     15,
				},
			}

			if err := h.db.Create(&settings).Error; err != nil {
				c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to create default settings"})
				return
			}
		} else {
			c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to fetch settings"})
			return
		}
	}

	// Decrypt sensitive fields for display (mask them)
	settingsResponse := h.maskSensitiveFields(settings)

	c.JSON(http.StatusOK, gin.H{"data": settingsResponse})
}

// UpdateIntegrationSettings updates integration settings
func (h *IntegrationHandler) UpdateIntegrationSettings(c *gin.Context) {
	organizationID := c.Param("organizationId")
	if organizationID == "" {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Organization ID is required"})
		return
	}

	var updateData models.IntegrationSettings
	if err := c.ShouldBindJSON(&updateData); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid request data"})
		return
	}

	// Get existing settings
	var existingSettings models.IntegrationSettings
	if err := h.db.Where("organization_id = ?", organizationID).First(&existingSettings).Error; err != nil {
		if err == gorm.ErrRecordNotFound {
			// Create new settings
			updateData.OrganizationID = organizationID
			if err := h.encryptSensitiveFields(&updateData); err != nil {
				c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to encrypt sensitive data"})
				return
			}

			if err := h.db.Create(&updateData).Error; err != nil {
				c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to create settings"})
				return
			}

			c.JSON(http.StatusCreated, gin.H{
				"message": "Integration settings created successfully",
				"data":    h.maskSensitiveFields(updateData),
			})
			return
		} else {
			c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to fetch existing settings"})
			return
		}
	}

	// Merge updates with existing settings
	updateData.ID = existingSettings.ID
	updateData.OrganizationID = organizationID
	updateData.CreatedAt = existingSettings.CreatedAt

	// Encrypt sensitive fields
	if err := h.encryptSensitiveFields(&updateData); err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to encrypt sensitive data"})
		return
	}

	// Update settings
	if err := h.db.Save(&updateData).Error; err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to update settings"})
		return
	}

	// Log integration event
	h.logIntegrationEvent(organizationID, "settings_updated", "success", "Integration settings updated", "", "")

	c.JSON(http.StatusOK, gin.H{
		"message": "Integration settings updated successfully",
		"data":    h.maskSensitiveFields(updateData),
	})
}

// TestStripeConnection tests Stripe connection
func (h *IntegrationHandler) TestStripeConnection(c *gin.Context) {
	organizationID := c.Param("organizationId")

	var settings models.IntegrationSettings
	if err := h.db.Where("organization_id = ?", organizationID).First(&settings).Error; err != nil {
		c.JSON(http.StatusNotFound, gin.H{"error": "Integration settings not found"})
		return
	}

	if err := h.stripeService.TestConnection(&settings.StripeSettings); err != nil {
		h.logIntegrationEvent(organizationID, "stripe_test_failed", "error", err.Error(), "", "")
		c.JSON(http.StatusBadRequest, gin.H{"error": fmt.Sprintf("Stripe connection test failed: %s", err.Error())})
		return
	}

	// Update settings with connection status
	if err := h.db.Save(&settings).Error; err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Failed to update connection status"})
		return
	}

	h.logIntegrationEvent(organizationID, "stripe_test_success", "success", "Stripe connection test successful", "", "")

	c.JSON(http.StatusOK, gin.H{
		"message": "Stripe connection test successful",
		"verified": true,
		"tested_at": settings.StripeSettings.LastTestedAt,
	})
}

