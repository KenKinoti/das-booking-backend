// Helper methods

func (h *IntegrationHandler) maskSensitiveFields(settings models.IntegrationSettings) models.IntegrationSettings {
	// Create a copy to avoid modifying the original
	masked := settings

	// Mask Stripe fields
	if masked.StripeSettings.SecretKey != "" {
		masked.StripeSettings.SecretKey = "sk_****"
	}
	if masked.StripeSettings.WebhookSecret != "" {
		masked.StripeSettings.WebhookSecret = "whsec_****"
	}

	// Mask PayPal fields
	if masked.PayPalSettings.ClientSecret != "" {
		masked.PayPalSettings.ClientSecret = "****"
	}

	// Mask Twilio fields
	if masked.TwilioSettings.AuthToken != "" {
		masked.TwilioSettings.AuthToken = "****"
	}

	// Mask WhatsApp fields
	if masked.WhatsAppSettings.AccessToken != "" {
		masked.WhatsAppSettings.AccessToken = "EAA****"
	}
	if masked.WhatsAppSettings.VerifyToken != "" {
		masked.WhatsAppSettings.VerifyToken = "****"
	}

	// Mask Zoho fields
	if masked.ZohoSettings.ClientSecret != "" {
		masked.ZohoSettings.ClientSecret = "****"
	}
	if masked.ZohoSettings.RefreshToken != "" {
		masked.ZohoSettings.RefreshToken = "****"
	}
	if masked.ZohoSettings.AccessToken != "" {
		masked.ZohoSettings.AccessToken = "****"
	}

	// Mask Email fields
	if masked.EmailSettings.SMTPPassword != "" {
		masked.EmailSettings.SMTPPassword = "****"
	}

	// Mask all API keys
	if masked.APIKeys.OpenAI != "" {
		masked.APIKeys.OpenAI = "sk-****"
	}
	if masked.APIKeys.Stripe != "" {
		masked.APIKeys.Stripe = "sk_****"
	}
	if masked.APIKeys.Twilio != "" {
		masked.APIKeys.Twilio = "****"
	}
	if masked.APIKeys.SendGrid != "" {
		masked.APIKeys.SendGrid = "SG.****"
	}
	if masked.APIKeys.Cloudinary != "" {
		masked.APIKeys.Cloudinary = "****"
	}
	if masked.APIKeys.Firebase != "" {
		masked.APIKeys.Firebase = "****"
	}
	if masked.APIKeys.Pusher != "" {
		masked.APIKeys.Pusher = "****"
	}
	if masked.APIKeys.Mailgun != "" {
		masked.APIKeys.Mailgun = "****"
	}
	if masked.APIKeys.GoogleMaps != "" {
		masked.APIKeys.GoogleMaps = "****"
	}
	if masked.APIKeys.AWSSecretKey != "" {
		masked.APIKeys.AWSSecretKey = "****"
	}

	return masked
}

func (h *IntegrationHandler) encryptSensitiveFields(settings *models.IntegrationSettings) error {
	// Encrypt Stripe fields
	if settings.StripeSettings.SecretKey != "" && settings.StripeSettings.SecretKey != "sk_****" {
		encrypted, err := h.encrypt.Encrypt(settings.StripeSettings.SecretKey)
		if err != nil {
			return err
		}
		settings.StripeSettings.SecretKey = encrypted
	}

	if settings.StripeSettings.WebhookSecret != "" && settings.StripeSettings.WebhookSecret != "whsec_****" {
		encrypted, err := h.encrypt.Encrypt(settings.StripeSettings.WebhookSecret)
		if err != nil {
			return err
		}
		settings.StripeSettings.WebhookSecret = encrypted
	}

	// Encrypt PayPal fields
	if settings.PayPalSettings.ClientSecret != "" && settings.PayPalSettings.ClientSecret != "****" {
		encrypted, err := h.encrypt.Encrypt(settings.PayPalSettings.ClientSecret)
		if err != nil {
			return err
		}
		settings.PayPalSettings.ClientSecret = encrypted
	}

	// Encrypt Twilio fields
	if settings.TwilioSettings.AuthToken != "" && settings.TwilioSettings.AuthToken != "****" {
		encrypted, err := h.encrypt.Encrypt(settings.TwilioSettings.AuthToken)
		if err != nil {
			return err
		}
		settings.TwilioSettings.AuthToken = encrypted
	}

	// Encrypt WhatsApp fields
	if settings.WhatsAppSettings.AccessToken != "" && settings.WhatsAppSettings.AccessToken != "EAA****" {
		encrypted, err := h.encrypt.Encrypt(settings.WhatsAppSettings.AccessToken)
		if err != nil {
			return err
		}
		settings.WhatsAppSettings.AccessToken = encrypted
	}

	if settings.WhatsAppSettings.VerifyToken != "" && settings.WhatsAppSettings.VerifyToken != "****" {
		encrypted, err := h.encrypt.Encrypt(settings.WhatsAppSettings.VerifyToken)
		if err != nil {
			return err
		}
		settings.WhatsAppSettings.VerifyToken = encrypted
	}

	// Encrypt Zoho fields
	if settings.ZohoSettings.ClientSecret != "" && settings.ZohoSettings.ClientSecret != "****" {
		encrypted, err := h.encrypt.Encrypt(settings.ZohoSettings.ClientSecret)
		if err != nil {
			return err
		}
		settings.ZohoSettings.ClientSecret = encrypted
	}

	if settings.ZohoSettings.RefreshToken != "" && settings.ZohoSettings.RefreshToken != "****" {
		encrypted, err := h.encrypt.Encrypt(settings.ZohoSettings.RefreshToken)
		if err != nil {
			return err
		}
		settings.ZohoSettings.RefreshToken = encrypted
	}

	if settings.ZohoSettings.AccessToken != "" && settings.ZohoSettings.AccessToken != "****" {
		encrypted, err := h.encrypt.Encrypt(settings.ZohoSettings.AccessToken)
		if err != nil {
			return err
		}
		settings.ZohoSettings.AccessToken = encrypted
	}

	// Encrypt Email fields
	if settings.EmailSettings.SMTPPassword != "" && settings.EmailSettings.SMTPPassword != "****" {
		encrypted, err := h.encrypt.Encrypt(settings.EmailSettings.SMTPPassword)
		if err != nil {
			return err
		}
		settings.EmailSettings.SMTPPassword = encrypted
	}

	// Encrypt API keys
	apiKeyFields := map[string]*string{
		"openai":        &settings.APIKeys.OpenAI,
		"stripe":        &settings.APIKeys.Stripe,
		"twilio":        &settings.APIKeys.Twilio,
		"sendgrid":      &settings.APIKeys.SendGrid,
		"cloudinary":    &settings.APIKeys.Cloudinary,
		"firebase":      &settings.APIKeys.Firebase,
		"pusher":        &settings.APIKeys.Pusher,
		"mailgun":       &settings.APIKeys.Mailgun,
		"google_maps":   &settings.APIKeys.GoogleMaps,
		"aws_secret":    &settings.APIKeys.AWSSecretKey,
	}

	for name, field := range apiKeyFields {
		if *field != "" && *field != "****" && *field != "sk_****" && *field != "SG.****" {
			encrypted, err := h.encrypt.Encrypt(*field)
			if err != nil {
				return fmt.Errorf("failed to encrypt %s API key: %w", name, err)
			}
			*field = encrypted
		}
	}

	return nil
}

func (h *IntegrationHandler) logIntegrationEvent(organizationID, event, status, message, errorCode, userID string) {
	logEntry := &models.IntegrationLog{
		OrganizationID: organizationID,
		Integration:    "system",
		Event:          event,
		Status:         status,
		Message:        message,
		ErrorCode:      errorCode,
		UserID:         userID,
	}

	if err := h.db.Create(logEntry).Error; err != nil {
		// Don't return error, just log it
		fmt.Printf("Failed to log integration event: %v\n", err)
	}
}