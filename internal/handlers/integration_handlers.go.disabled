// SendTestEmail sends a test email
func (h *IntegrationHandler) SendTestEmail(c *gin.Context) {
	organizationID := c.Param("organizationId")

	var requestData struct {
		ToEmail string `json:"to_email" binding:"required,email"`
		Subject string `json:"subject"`
		Message string `json:"message"`
	}

	if err := c.ShouldBindJSON(&requestData); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid request data"})
		return
	}

	subject := requestData.Subject
	if subject == "" {
		subject = "Test Email from DAS Booking Platform"
	}

	message := requestData.Message
	if message == "" {
		message = "This is a test email to verify your email configuration is working correctly."
	}

	emailMessage := &integrations.EmailMessage{
		To:        []string{requestData.ToEmail},
		Subject:   subject,
		PlainBody: message,
		HTMLBody:  fmt.Sprintf("<p>%s</p>", message),
		Priority:  "normal",
	}

	if err := h.emailService.SendEmail(organizationID, emailMessage); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": fmt.Sprintf("Failed to send test email: %s", err.Error())})
		return
	}

	c.JSON(http.StatusOK, gin.H{"message": "Test email sent successfully"})
}

// SendTestSMS sends a test SMS
func (h *IntegrationHandler) SendTestSMS(c *gin.Context) {
	organizationID := c.Param("organizationId")

	var requestData struct {
